# Contraseña del portal (required). Se requiere para acceder a la app.
# No la hardcodees aquí; configúrala en .env (gitignored) o en Vercel.
VITE_APP_PASSWORD=

# Clave de API de Anthropic para el asistente IA (función /api/chat).
# Consíguela en https://console.anthropic.com/ y configúrala en Vercel
# (Project Settings → Environment Variables). No la subas al repositorio.
ANTHROPIC_API_KEY=

# Opcional: modelo a usar. Por defecto claude-opus-4-8.
# Para reducir coste puedes usar, por ejemplo, claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-opus-4-8

# Conexión a Neon Postgres (funciones /api/health y siguientes). La inyecta
# la integración de Neon en Vercel; en local, tráela con:
#   npx vercel env pull .env.local
DATABASE_URL=

# Panel de gestión (/admin). No hay registro público: estas credenciales son
# las únicas que dan acceso. Solo las lee el servidor (nunca el navegador),
# así que NO llevan el prefijo VITE_.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secreto para firmar el JWT de sesión (mínimo 32 caracteres). Si cambia,
# todas las sesiones abiertas se invalidan. Genéralo con:
#   openssl rand -base64 48
ADMIN_JWT_SECRET=

# Opcionales: nombre mostrado en el panel y organización a la que pertenece
# la cuenta (por defecto, "Gestor" y la organización tyl-tyl).
# ADMIN_NOMBRE=
# ADMIN_ORG_SLUG=tyl-tyl

# Vercel Blob: almacena las imágenes de los eventos creados desde /admin.
# La inyecta la integración de Blob en Vercel; en local, tráela con
# `npx vercel env pull .env.local`. Sin ella, la subida de imágenes se
# desactiva (el resto del formulario sigue funcionando).
BLOB_READ_WRITE_TOKEN=

# Opcional (formulario "sugerir comercio"): endpoint de un servicio de
# formularios como Formspree/Web3Forms. Si se deja vacío, se usa mailto.
# VITE_FORM_ENDPOINT=
