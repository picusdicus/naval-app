# Contraseña del candado del portal vecinal (required). La verifica el SERVIDOR
# (api/acceso.js), así que NO lleva el prefijo VITE_ y nunca llega al navegador.
# No la hardcodees aquí; configúrala en .env (gitignored) o en Vercel.
APP_ACCESO_PASSWORD=

# Clave de API de Anthropic para el asistente IA (función /api/chat).
# Consíguela en https://console.anthropic.com/ y configúrala en Vercel
# (Project Settings → Environment Variables). No la subas al repositorio.
ANTHROPIC_API_KEY=

# Opcional: modelo a usar. Por defecto claude-opus-4-8.
# Para reducir coste puedes usar, por ejemplo, claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-opus-4-8

# Conexión a Neon Postgres (funciones /api/health y siguientes). La inyecta
# la integración de Neon en Vercel; en local, tráela con:
#   npx vercel env pull .env.local
DATABASE_URL=

# Panel de gestión (/admin). No hay registro público: estas credenciales son
# las únicas que dan acceso. Solo las lee el servidor (nunca el navegador),
# así que NO llevan el prefijo VITE_.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secreto para firmar el JWT de sesión (mínimo 32 caracteres). Si cambia,
# todas las sesiones abiertas se invalidan. Genéralo con:
#   openssl rand -base64 48
ADMIN_JWT_SECRET=

# Opcionales: nombre mostrado en el panel y organización a la que pertenece
# la cuenta (por defecto, "Gestor" y la organización tyl-tyl).
# ADMIN_NOMBRE=
# ADMIN_ORG_SLUG=tyl-tyl

# Vercel Blob: almacena los carteles de los eventos creados desde /admin.
#
# En los despliegues de Vercel basta con OIDC: la integración inyecta
# BLOB_STORE_ID y VERCEL_OIDC_TOKEN, y no hace falta nada más.
#
# En local, OIDC está desactivado para el entorno `development`, así que se
# usa el token de lectura/escritura del store (Vercel → Storage → el store →
# pestaña de tokens). Si falta, la subida de imágenes se desactiva con un
# aviso claro y el resto del formulario sigue funcionando.
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=store_…

# Opcional (formulario "sugerir comercio"): endpoint de un servicio de
# formularios como Formspree/Web3Forms. Si se deja vacío, se usa mailto.
# VITE_FORM_ENDPOINT=

# Secreto del cron de sincronización de eventos (/api/sync-events). Vercel Cron
# lo envía como `Authorization: Bearer <CRON_SECRET>`. OBLIGATORIO: sin él, el
# endpoint rechaza toda petición (falla cerrado). Genéralo con:
#   openssl rand -base64 32
CRON_SECRET=

# Upstash Redis para el rate-limiting (login, registro, chat, track, candado).
# La integración de Upstash en el Vercel Marketplace las inyecta. Según cómo se
# provisione, usa uno de estos dos juegos de nombres (el código acepta ambos):
#   - UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN   (estilo Upstash)
#   - KV_REST_API_URL        / KV_REST_API_TOKEN          (estilo Vercel KV)
# Si faltan (p. ej. en desarrollo), el rate-limit se desactiva (fail-open).
KV_REST_API_URL=
KV_REST_API_TOKEN=
