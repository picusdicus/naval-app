# Clave de API de Anthropic para el asistente IA (función /api/chat).
# Consíguela en https://console.anthropic.com/ y configúrala en Vercel
# (Project Settings → Environment Variables). No la subas al repositorio.
ANTHROPIC_API_KEY=

# Opcional: modelo a usar. Por defecto claude-opus-4-8.
# Para reducir coste puedes usar, por ejemplo, claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-opus-4-8

# Opcional (formulario "sugerir comercio"): endpoint de un servicio de
# formularios como Formspree/Web3Forms. Si se deja vacío, se usa mailto.
# VITE_FORM_ENDPOINT=
